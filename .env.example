# Supabase project URL and anon/public key (browser-safe).
# The preview VM injects these from workspace Secrets at runtime.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: override the public origin used for OAuth / password-reset redirects.
# If omitted, window.location.origin is used.
VITE_APP_URL=
